# Chinese Tech Wire — macOS local dev environment template.
# mac/bootstrap copies this to .env (gitignored) on first run if none exists.
# Nothing below is a real secret. Leave the optional integrations unset for
# local development -- everything works without them.

# --- Optional: Discord notifications ---------------------------------------
# Leave EMPTY for local dev. Never put the real/production webhook here --
# Hetzner soak has its own, separate .env; this file is Mac-local only.
DISCORD_WEBHOOK_URL=

# --- Optional: translation (dev-only convenience, not required) ------------
# Provider: none | gemini | openai | openai-compatible | custom
TRANSLATION_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4o-mini

# --- Optional: embedding-based dedup (future, not required) ----------------
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# --- Development-only: local database ---------------------------------------
# Repo-relative and gitignored. Not the Hetzner soak database.
DATABASE_URL=sqlite:///data/ctw.db

LOG_LEVEL=INFO
