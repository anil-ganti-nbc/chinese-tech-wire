#!/usr/bin/env bash
# Print runtime identity, then health -- both against the local dev
# database (data/ctw.db).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -x ".venv/bin/python" ]; then
    echo "error: no .venv found. Run mac/bootstrap first." >&2
    exit 1
fi

echo "=== identity ==="
.venv/bin/python main.py --identity
echo ""
echo "=== health ==="
.venv/bin/python main.py --health
