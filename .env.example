# Discord webhook for notifications (required for alerts)
DISCORD_WEBHOOK_URL=

# Translation provider: none | gemini | openai | openai-compatible | custom
TRANSLATION_PROVIDER=none

# --- Gemini (preferred) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI-compatible (optional) ---
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4o-mini

# Optional embedding for advanced dedup (future)
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# Database path (default: data/ctw.db)
DATABASE_URL=sqlite:///data/ctw.db

# Log level
LOG_LEVEL=INFO
